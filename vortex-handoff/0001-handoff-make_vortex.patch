+            }
+        } else {
+            sender.sendMessage(
+                Text.mm(
+                    "<gradient:#9B5CFF:#4FC3FF><b>Vortex Realm</b></gradient> <gray>v"
+                        + this.plugin.getPluginMeta().getVersion()
+                        + " <dark_gray>- <gray>MCPVP-style practice, SMP and more. <white>/vortex migrate"
+                )
+            );
+        }
+
+        return true;
+    }
+
